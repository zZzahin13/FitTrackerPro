rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Day 8B: Each authenticated user can only read and write their own profile
    // and subcollections (activity_logs, workout_sessions, weight_history).
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
